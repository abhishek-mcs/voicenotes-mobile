    "build:android": "yarn prepare && eas build --platform android --profile production --auto-submit",
    "build:ios": "yarn prepare && eas build --platform ios --profile production --auto-submit",
    "build:all": "yarn prepare && eas build --platform all --profile production --auto-submit"
