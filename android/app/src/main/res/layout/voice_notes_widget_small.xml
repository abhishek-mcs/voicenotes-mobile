<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/btn_layout"
    android:padding="15dp"
    android:theme="@style/Theme.VoiceNotesWidget.AppWidgetWholeContainer">


    <Button
        android:id="@+id/record_btn"
        style="@style/Widget.VoiceNotesWidget.AppWidget.InnerView"
        android:layout_width="180dp"
        android:layout_height="75dp"
        android:background="@drawable/app_widget_background"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:text="@string/record"
        android:textSize="22sp"
        android:textStyle="bold"
        android:theme="@style/Theme.VoiceNotesWidget.AppWidgetRecord" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="15dp"/>

    <Button
        android:id="@+id/ask_btn"
        style="@style/Widget.VoiceNotesWidget.AppWidget.InnerView"
        android:layout_width="180dp"
        android:layout_height="75dp"
        android:background="@drawable/app_widget_background"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:text="@string/ask"
        android:textSize="22sp"
        android:textStyle="bold"
        android:theme="@style/Theme.VoiceNotesWidget.AppWidgetAsk" />
</LinearLayout>